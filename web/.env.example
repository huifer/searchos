# SearchOS Console environment

# Gateway base URL. The console talks to this through its server-side proxy
# (`/api/searchos/*`), so browser CORS is not required.
SEARCHOS_GATEWAY_URL=http://127.0.0.1:8787

# Optional bearer token, kept server-side only. Never expose it to the browser.
SEARCHOS_AUTH_TOKEN=

# Public origin used to resolve relative OG image URLs in metadata.
NEXT_PUBLIC_SITE_URL=
